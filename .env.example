# Backend origin (same server and database as the phone app). No trailing slash, no /api.
VITE_API_URL=https://our-space-stg.onrender.com
# Google "Web application" OAuth client ID — the same one the backend has as GOOGLE_CLIENT_ID.
# Add this site's address under "Authorized JavaScript origins" for that client in Google Cloud.
VITE_GOOGLE_CLIENT_ID=351421523260-04n8q3b4g79ofjpins9sd4m12933b9rl.apps.googleusercontent.com
# Store links for "Get the app" (steps). Leave empty for defaults: Play listing for com.ourspace.mobile, App Store "coming soon".
VITE_ANDROID_URL=
VITE_IOS_URL=
